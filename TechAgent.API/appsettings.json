{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=techagent;Username=appUser;Password=CHANGE_ME;Maximum Pool Size=50;Minimum Pool Size=5;Enlist=false"
  },
  "Telegram": {
    "BotToken": "YOUR_TELEGRAM_BOT_TOKEN",
    "ChatId": "YOUR_TELEGRAM_CHAT_ID"
  },
  "AI": {
    "Provider": "Ollama",
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "ChatModel": "oilgas-assistant",
      "EmbeddingModel": "nomic-embed-text"
    },
    "OpenAI": {
      "ApiKey": "YOUR_OPENAI_API_KEY",
      "ChatModel": "gpt-4o-mini",
      "EmbeddingModel": "text-embedding-3-small"
    },
    "Claude": {
      "ApiKey": "YOUR_CLAUDE_API_KEY",
      "ChatModel": "claude-sonnet-4-6"
    }
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "CollectionName": "oilgas_documents",
    "VectorSize": 768,
    "MinSimilarityScore": 0.45
  },
  "AppSettings": {
    "NewsSettings": {
      "Feeds": [
        "https://feeds.feedburner.com/TechCrunch/",
        "https://www.theverge.com/rss/index.xml",
        "https://devblogs.microsoft.com/dotnet/feed/",
        "https://openai.com/blog/rss.xml",
        "https://medium.com/feed/tag/artificial-intelligence",
        "https://medium.com/feed/tag/dotnet",
        "https://medium.com/feed/tag/angular"
      ],
      "Keywords": [
        ".NET",
        "Angular",
        "C#",
        "ASP.NET",
        "Kubernetes",
        "Azure",
        "AI",
        "LLM",
        "PostgreSQL",
        "docker"
      ]
    }
  }
}
